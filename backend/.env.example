# Copy to .env; never commit your real credentials.
NODE_ENV=development
PORT=3000
SERVE_WEB=false
MONGODB_URI=mongodb://127.0.0.1:27017/signvoice?replicaSet=rs0
# Generate TWO different random secrets, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001
PUBLIC_ORIGIN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LOG_LEVEL=info
ADMIN_EMAIL=admin@signvoice.local
ADMIN_PASSWORD=
