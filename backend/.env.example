# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/signvoice

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=replace-with-your-own-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-your-own-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
WEB_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# OAuth2 (Configure when ready)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Logging
LOG_LEVEL=debug

# Development Admin (FOR DEVELOPMENT ONLY)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-your-own-admin-password

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_FROM=SignVoice <noreply@example.com>
SMTP_PASS=
PASSWORD_RESET_ORIGIN=
# SignVoice learning analysis only. Does not change other LM Studio projects.
SIGNVOICE_LM_STUDIO_URL=http://127.0.0.1:1235/v1
SIGNVOICE_LM_STUDIO_MODEL=qwen3-4b-instruct-2507
# Optional: only when Require Authentication is enabled in LM Studio.
SIGNVOICE_LM_STUDIO_API_KEY=
