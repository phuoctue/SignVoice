# Copy to .env; never commit your real credentials.
NODE_ENV=development
PORT=3000
SERVE_WEB=false
MONGODB_URI=mongodb://127.0.0.1:27017/signvoice?replicaSet=rs0
# Generate TWO different random secrets, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:8080
PRIVACY_OPERATOR_NAME=
SUPPORT_EMAIL=
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001
PUBLIC_ORIGIN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Web OAuth: public frontend and backend must use the same HTTPS origin.
OAUTH_BACKEND_ORIGIN=http://localhost:3000
OAUTH_FRONTEND_ORIGIN=http://localhost:8080
GOOGLE_CALLBACK_URL=
FACEBOOK_CALLBACK_URL=
# Set a supported Graph API version from your Meta app dashboard.
FACEBOOK_GRAPH_API_VERSION=
OAUTH_STATE_TTL_SECONDS=600
LOG_LEVEL=info
ADMIN_EMAIL=admin@signvoice.local
ADMIN_PASSWORD=
# SignVoice learning analysis only. Does not change other LM Studio projects.
SIGNVOICE_LM_STUDIO_URL=http://127.0.0.1:1235/v1
SIGNVOICE_LM_STUDIO_MODEL=qwen3-4b-instruct-2507
# Optional: only when Require Authentication is enabled in LM Studio.
SIGNVOICE_LM_STUDIO_API_KEY=
