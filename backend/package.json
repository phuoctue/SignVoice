{
  "name": "signvoice-backend",
  "version": "1.0.0",
  "description": "SignVoice Backend API - Node.js + Express + TypeScript + MongoDB",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "smtp:verify": "tsx scripts/verify-smtp.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:seed": "tsx scripts/seed.ts",
    "db:clean": "tsx scripts/cleanup.ts",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "db:create-test-accounts": "tsx scripts/create-test-accounts.ts",
    "docs:validate": "tsx scripts/validate-openapi.ts",
    "docs:coverage": "tsx scripts/check-api-coverage.ts"
  },
  "keywords": [
    "signvoice",
    "api",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "SignVoice Team",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "argon2": "^0.31.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "nodemailer": "^10.0.16",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "ws": "^8.22.0"
  }
}
